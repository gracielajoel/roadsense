# URL backend FastAPI (tanpa /api/v1 dan tanpa slash di akhir)
VITE_API_BASE_URL=http://localhost:8000

# true = pakai data demo di src/mocks (backend tidak perlu jalan)
# false = semua request ke backend sungguhan
VITE_USE_MOCK=false

# Buka dari HP (live scan butuh HTTPS untuk kamera): kosongkan baris di bawah,
# request akan lewat proxy Vite (/api, /files) ke backend. Lihat README bagian "Live scan".
# VITE_API_BASE_URL=
