# Salin file ini jadi .env (Windows: copy .env.example .env | macOS/Linux: cp .env.example .env)
# File .env tidak ikut git, jadi aman diisi nilai asli.

# --- Database: pilih salah satu ---

# A) PostgreSQL dari docker-compose.yml (port 5433, bukan 5432). Dipakai untuk demo.
DATABASE_URL=postgresql+psycopg2://roadsense:roadsense@localhost:5433/roadsense

# B) SQLite: tanpa Docker, cocok untuk coba-coba cepat
# DATABASE_URL=sqlite:///./roadsense.db

# Folder penyimpanan video, foto evidence, dan foto after-repair
STORAGE_DIR=./storage

# Origin frontend yang boleh akses API (pisah dengan koma)
CORS_ORIGINS=http://localhost:5173,http://localhost:7860

# --- Model deteksi ---
MODEL_PATH=./weights/budget80_map50_epoch79.pt
MODEL_IMGSZ=512
MODEL_CONF=0.25
TRACKER_CONFIG=botsort.yaml
VID_STRIDE=1
MIN_TRACK_FRAMES=3

# true = pakai deteksi dummy (cadangan demo kalau model bermasalah / tidak mendeteksi apa pun)
# false = pakai model asli di MODEL_PATH
USE_DUMMY_INFERENCE=false

# --- Login ---
# WAJIB diganti dengan string acak panjang. Buat dengan:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=ganti-dengan-string-acak-panjang
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Batas ukuran foto after-repair (MB)
MAX_PHOTO_MB=10
